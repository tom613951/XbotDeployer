<ui:FluentWindow x:Class="XbotDeployer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="XbotDeployer - 影刀应用一键迁移与部署工具"
        Height="780" Width="1180"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏区域 -->
        <ui:TitleBar Grid.Row="0" Title="XbotDeployer - 影刀应用一键迁移与部署工具">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部工具栏 -->
            <Border Grid.Row="0" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBlock Grid.Column="0" Text="当前影刀用户:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                <ComboBox Grid.Column="1" x:Name="CmbUsers" SelectionChanged="CmbUsers_SelectionChanged"
                          DisplayMemberPath="DisplayLabel" Margin="0,0,12,0" />
                
                <ui:Button Grid.Column="2" Content="刷新列表" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Click="BtnRefresh_Click" Margin="0,0,8,0" />
                <ui:Button Grid.Column="3" Content="清理缓存" Icon="{ui:SymbolIcon Symbol=Broom24}" Click="BtnCleanCache_Click" Margin="0,0,8,0" />
                <ui:Button Grid.Column="4" Content="自定义目录" ToolTip="手动指定非默认盘符（D盘/E盘等）的影刀安装或数据目录" Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Click="BtnCustomDir_Click" Margin="0,0,8,0" />

                <ui:TextBlock Grid.Column="6" x:Name="LblAppSummary" Text="共 0 个应用" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- 主操作区: 左右分栏 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="480" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- 左侧: 本地应用列表 -->
            <Border Grid.Column="0" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 搜索框 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Text="本地应用列表" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <ui:TextBox Grid.Column="1" x:Name="TxtSearch" PlaceholderText="输入应用名称或 UUID 快速过滤..." TextChanged="TxtSearch_TextChanged" ClearButtonEnabled="True" />
                    </Grid>

                    <!-- 应用表格 -->
                    <DataGrid Grid.Row="1" x:Name="GridApps" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow"
                              BorderThickness="1" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                              Background="Transparent" RowHeaderWidth="0" MouseDoubleClick="GridApps_MouseDoubleClick"
                              ContextMenuOpening="GridApps_ContextMenuOpening">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="重命名应用" Click="MenuItem_Rename_Click">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Edit24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="删除应用" Click="MenuItem_Delete_Click">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Delete24" Foreground="#E05555" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="打开所在文件夹" Click="MenuItem_OpenFolder_Click">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="FolderOpen24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="查看应用详情" Click="MenuItem_Detail_Click">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Info24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridRow">
                                            <Border Name="DGR_Border" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4" SnapsToDevicePixels="True">
                                                <Grid>
                                                    <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                    <Rectangle Name="ActiveIndicator" Width="3" Height="16"
                                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                                               Fill="{DynamicResource ListViewItemPillFillBrush}"
                                                               RadiusX="1.5" RadiusY="1.5" Opacity="0" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1" />
                                                    <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="46" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridColumnHeader">
                                                    <Border Background="Transparent" Padding="0">
                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Background="Transparent" Padding="0">
                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="ChkSelectAllHeader" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="0" Padding="0" Click="ChkSelectAllHeader_Click" ToolTip="全选 / 全不选" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0" Padding="0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="应用名称" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="修改时间" Binding="{Binding MtimeStr}" Width="150" />
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeStr}" Width="80" />
                            <DataGridTextColumn Header="流数量" Binding="{Binding FlowCount}" Width="65" />
                            <DataGridTextColumn Header="UUID" Binding="{Binding Uuid}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 左侧底部操作栏 -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0" Content="全选" Click="BtnSelectAll_Click" Margin="0,0,6,0" />
                        <ui:Button Grid.Column="1" Content="反选" Click="BtnInvertSelection_Click" Margin="0,0,6,0" />
                        <ui:Button Grid.Column="3" Content="导出选中应用为 Zip 备份" Icon="{ui:SymbolIcon Symbol=FolderZip24}" Click="BtnExportZip_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 分割线 -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- 右侧: 接收人设置与迁移终端 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 接收方账号配置 -->
                <Border Grid.Row="0" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="12" Margin="0,0,0,10"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <ui:TextBlock Text="目标接收方账号" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0" Text="常用联系人:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="CmbContacts" SelectionChanged="CmbContacts_SelectionChanged" Margin="0,0,6,0" />
                            <ui:Button Grid.Column="2" Content="管理" Click="BtnManageContacts_Click" />
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0" Text="接收人账号:" VerticalAlignment="Center" />
                            <ui:TextBox Grid.Column="1" x:Name="TxtTargetUser" PlaceholderText="手机号 / 用户名" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0" Text="接收人密码:" VerticalAlignment="Center" />
                            <ui:PasswordBox Grid.Column="1" x:Name="TxtTargetPassword" PlaceholderText="影刀登录密码" />
                        </Grid>

                        <CheckBox x:Name="ChkRememberContact" Content="保存该账号到常用联系人" IsChecked="True" />
                    </StackPanel>
                </Border>

                <!-- 迁移与打包选项 -->
                <Border Grid.Row="1" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="12" Margin="0,0,0,10"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <ui:TextBlock Text="迁移选项" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox x:Name="ChkAddSuffix" Content="追加接收时间戳后缀（防止同名覆盖）" IsChecked="True" Margin="0,0,0,4" />
                        <CheckBox x:Name="ChkEncryptPython" Content="编译 Python 源码为字节码 (.py -> .pyc)" IsChecked="False" />
                    </StackPanel>
                </Border>

                <!-- 迁移按钮与进度 -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <ui:Button x:Name="BtnMigrate" Content="开始一键迁移选中应用" Appearance="Primary"
                               Height="40" HorizontalAlignment="Stretch" FontWeight="SemiBold" FontSize="15"
                               Icon="{ui:SymbolIcon Symbol=Play24}" Click="BtnMigrate_Click" />
                    <ProgressBar x:Name="ProgressBarMigration" Height="6" Margin="0,8,0,0" Value="0" />
                </StackPanel>

                <!-- 日志控制台 -->
                <Border Grid.Row="3" Background="#1E1E1E" CornerRadius="8" Padding="10"
                        BorderBrush="#333333" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <ui:TextBlock Text="迁移日志输出" Foreground="#A0A0A0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button Content="清空" HorizontalAlignment="Right" Padding="8,2" FontSize="11" Click="BtnClearLog_Click" />
                        </Grid>

                        <RichTextBox Grid.Row="1" x:Name="RtfLog" Background="Transparent" Foreground="#D4D4D4"
                                     BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
