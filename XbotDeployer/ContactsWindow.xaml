<ui:FluentWindow x:Class="XbotDeployer.ContactsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="常用接收人管理"
        Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏区域 -->
        <ui:TitleBar Grid.Row="0" Title="常用接收人管理" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 表格区 -->
            <Border Grid.Row="0" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12" Margin="0,0,0,12"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0" Text="已保存的接收人列表" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid Grid.Row="1" x:Name="GridContacts" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                              BorderThickness="1" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                              Background="Transparent" RowHeaderWidth="0" SelectionChanged="GridContacts_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="影刀账号" Binding="{Binding Username}" Width="*" />
                            <DataGridTextColumn Header="备注 / 姓名" Binding="{Binding Remark}" Width="150" />
                            <DataGridTextColumn Header="添加时间" Binding="{Binding CreatedAt}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 编辑区 -->
            <Border Grid.Row="1" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Text="账号:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ui:TextBox Grid.Column="1" x:Name="TxtUser" PlaceholderText="手机号 / 用户名" Margin="0,0,12,0" />

                        <ui:TextBlock Grid.Column="2" Text="密码:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ui:PasswordBox Grid.Column="3" x:Name="TxtPwd" PlaceholderText="接收方密码" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Text="备注:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ui:TextBox Grid.Column="1" x:Name="TxtRemark" PlaceholderText="如: 客户A / 测试账号" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="保存 / 更新" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save24}" Click="BtnSave_Click" Margin="0,0,8,0" />
                        <ui:Button Content="删除选中" Icon="{ui:SymbolIcon Symbol=Delete24}" Click="BtnDelete_Click" Margin="0,0,8,0" />
                        <ui:Button Content="清空输入" Click="BtnClear_Click" Margin="0,0,8,0" />
                        <ui:Button Content="关闭" Click="BtnClose_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
